#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/outputs.h>

#define LAYER0 0
#define LAYER1 1
#define LAYER2 2
#define LAYER3 3

&mmv {
  acceleration-exponent = <1>;      // 1
  time-to-max-speed-ms = <500>;    // 40
  delay-ms = <0>;                   // 0
};
&msc {
  acceleration-exponent = <1>;      // 0
  time-to-max-speed-ms = <40>;      // 500
  delay-ms = <0>;                   // 10
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};
&mt {
    tapping-term-ms = <400>;
    quick-tap-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            bindings = <
&kp PSCRN         &kp N1  &kp N2          &kp N3       &kp N4          &kp N5                             &bt BT_SEL 0                                   &bt BT_SEL 0                     &kp N6             &kp N7           &kp N8            &kp N9             &kp N0       &kp LS(LCTRL) 
&kp LG(A)         &kp Q   &mt LSHFT W     &mt LCTRL F  &mt LALT P      &kp B                 &bt BT_SEL 0 &bt BT_SEL 0 &bt BT_SEL 0         &bt BT_SEL 0 &bt BT_SEL 0  &bt BT_SEL 0       &kp J              &mt RALT L       &mt RCTRL U       &mt RSHFT Y        &kp QMARK    &kp INS
&kp LWIN          &kp A   &mt LSHFT R     &mt LCTRL S  &mt LALT T      &kp G                              &bt BT_SEL 0                                   &bt BT_SEL 0                     &kp M              &mt RALT N       &mt RCTRL E       &mt RSHFT I        &kp O        &mt RWIN CLCK
&kp ESC           &kp Z   &mt LSHFT X     &mt LCTRL C  &mt LALT D      &kp V                 &kp C_MUTE                                                                &kp C_MUTE         &kp K              &mt RALT H       &mt RCTRL COMMA   &mt RSHFT DOT      &kp SQT      &kp DEL
                                                                       &lt LAYER1 BACKSPACE  &lt LAYER2 TAB                                                            &lt LAYER3 ENTER   &mt LSHFT SPACE 
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_1 {
            bindings = <
&kp PSCRN       &kp N1      &kp N2             &kp N3            &kp N4             &kp N5                      &bt BT_SEL 0                                   &bt BT_SEL 0                    &kp N6     &kp N7            &kp N8             &kp N9                &kp N0        &kp LS(LCTRL) 
&kp LG(A)       &kp PRCNT   &mt LSHFT PIPE     &mt LCTRL AT      &mt LALT LBKT      &kp RBKT       &bt BT_SEL 0 &bt BT_SEL 0 &bt BT_SEL 0         &bt BT_SEL 0 &bt BT_SEL 0  &bt BT_SEL 0      &kp LBRC   &mt RALT RBRC     &mt RCTRL CARET    &mt RSHFT POUND       &kp EXCL      &kp INS
&kp LWIN        &kp TILDE   &mt LSHFT FSLH     &mt LCTRL MINUS   &mt LALT LPAR      &kp RPAR                    &bt BT_SEL 0                                   &bt BT_SEL 0                    &kp LT     &mt RALT GT       &mt RCTRL PLUS     &mt RSHFT STAR        &kp EQUAL     &mt RWIN CLCK
&kp ESC         &kp GRAVE   &mt LSHFT BSLH     &mt LCTRL UNDER   &mt LALT DLLR      &none          &trans                                                                        &trans        &none      &mt RALT AMPS     &mt RCTRL SEMI     &mt RSHFT COLON       &kp DQT       &kp DEL
                                                                                    &trans         &kp TAB                                                                       &kp ENTER     &kp SPACE  
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_2 {
            bindings = <
&kp F11      &kp F1      &kp F2        &kp F3      &kp F4      &kp F5                      &bt BT_SEL 0                                   &bt BT_SEL 0                  &kp F6     &kp F7          &kp F8      &kp F9      &kp F10    &kp F12
&kp LG(A)    &kp LC(Z)   &kp LC(Y)     &kp UP      &kp HOME    &kp END        &bt BT_SEL 0 &bt BT_SEL 0 &bt BT_SEL 0         &bt BT_SEL 0 &bt BT_SEL 0  &bt BT_SEL 0    &none      &none           &none       &none       &none      &kp INS
&kp LWIN     &kp LC(S)   &kp LEFT      &kp DOWN    &kp RIGHT   &kp LG(V)                   &bt BT_SEL 0                                   &bt BT_SEL 0                  &none      &kp RALT        &kp RCTRL   &kp RSHFT   &none      &mt RWIN CLCK
&kp ESC      &kp LC(A)   &kp LC(X)     &kp LC(C)   &kp LC(V)   &kp LG(SEMI)   &trans                                                                    &trans          &none      &none           &none       &none       &none      &kp DEL
                                                               &kp BACKSPACE  &trans                                                                    &kp ENTER       &kp SPACE 
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_3 {
            bindings = <
&kp F11    &kp F1         &kp F2          &kp F3          &kp F4           &kp F5                          &bt BT_SEL 0                                   &bt BT_SEL 0                 &kp F6      &kp F7      &kp F8      &kp F9     &kp F10   &kp F12
&kp LG(A)  &kp LA(LEFT)   &kp LA(RIGHT)   &mmv MOVE_UP    &msc SCRL_UP     &msc SCRL_DOWN     &bt BT_SEL 0 &bt BT_SEL 0 &bt BT_SEL 0         &bt BT_SEL 0 &bt BT_SEL 0  &bt BT_SEL 0   &none       &none       &none       &none      &none     &kp INS
&kp LWIN   &kp LC(TAB)    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LA(TAB)                     &bt BT_SEL 0                                   &bt BT_SEL 0                 &none       &kp RALT    &kp RCTRL   &kp RSHFT  &none     &mt RWIN CLCK
&kp ESC    &kp RC(A)      &kp RC(X)       &kp RC(C)       &kp RC(V)        &mkp MCLK          &trans                                                                    &trans         &none       &none       &none       &none      &none     &kp DEL
                                                                           &mkp LCLK          &mkp RCLK                                                                 &trans         &kp SPACE 
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

    };
};
