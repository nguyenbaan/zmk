#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mmv {
  acceleration-exponent = <1>;      // 1
  time-to-max-speed-ms = <500>;    // 40
  delay-ms = <0>;                   // 0
};
&msc {
  acceleration-exponent = <1>;      // 0
  time-to-max-speed-ms = <40>;      // 500
  delay-ms = <0>;                   // 10
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};
&mt {
    tapping-term-ms = <400>;
    quick-tap-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
&kp C_AL_MY_COMPUTER &kp C_AL_DOCS  &kp C_AL_FILES   &kp N3   &kp N4    &kp N5   &kp N1                   &kp N6     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &none
&kp C_AL_WWW   &kp Q  &kp W    &kp E    &kp R     &kp T    &kp N2 &kp N3 &kp N4      &kp N7 &kp N8 &kp N9                  &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp K_WWW   &kp A  &kp S    &kp D    &kp F     &kp G     &kp N5                     &kp N0  &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE   &kp C_MUTE    &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                  &kp W    &kp E    &kp R     &kp T
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5   &kp N1                   &kp N6     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &none
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T    &kp N2 &kp N3 &kp N4      &kp N7 &kp N8 &kp N9                  &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G     &kp N5                     &kp N0  &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE   &kp C_MUTE    &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                  &kp W    &kp E    &kp R     &kp T
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5   &kp N1                   &kp N6     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &none
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T    &kp N2 &kp N3 &kp N4      &kp N7 &kp N8 &kp N9                  &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G     &kp N5                     &kp N0  &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE   &kp C_MUTE    &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                  &kp W    &kp E    &kp R     &kp T
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "adjust";
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5   &kp N1                   &kp N6     &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &none
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T    &kp N2 &kp N3 &kp N4      &kp N7 &kp N8 &kp N9                  &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G     &kp N5                     &kp N0  &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE   &kp C_MUTE    &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                  &kp W    &kp E    &kp R     &kp T
            >;
        };

    };
};
